# .env.example
#
# Шаблон переменных окружения для докер-стека DOPX. Скопируй в .env
# (`cp .env.example .env`) и заполни реальными значениями. Файл .env
# уже в .gitignore — секреты в git не попадут.
#
# ВАЖНО: значения DB_HOST/REDIS_URL/CELERY_*_URL ниже — для локального
# запуска БЕЗ Docker. Внутри docker-compose.yml они переопределены на
# правильные адреса (db/redis по именам сервисов) автоматически —
# трогать в .env для докер-деплоя эти три переменные не нужно.

# =============================================================================
# Django core
# =============================================================================
# Сгенерировать новый: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-random-secret-key
DEBUG=False
ALLOWED_HOSTS=dopx.kz,www.dopx.kz
# Полные origin'ы (со схемой https://) через запятую — без этого на проде
# будут падать все формы (вход/регистрация/оценки) с ошибкой CSRF.
CSRF_TRUSTED_ORIGINS=https://dopx.kz,https://www.dopx.kz
ENVIRONMENT=production

# =============================================================================
# База данных (PostgreSQL)
# =============================================================================
DB_NAME=dopx
DB_USER=dopx
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# Redis (Celery broker + Django cache)
# =============================================================================
REDIS_URL=redis://localhost:6379/1
# Отдельная переменная для кэша агрегатов (aggregates/services.py) — важно
# держать её ОТДЕЛЬНО от REDIS_URL выше, а не просто менять номер БД в
# том же значении: это две разные логические базы Redis (см. комментарий
# у CACHES в dopx/settings.py).
REDIS_AGGREGATES_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# Почта
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@dopx.kz
CONTACT_EMAIL=admin@dopx.kz
ADMIN_ALERT_EMAIL=admin@dopx.kz
ENABLE_SYNC_ERROR_ALERTS=True

# =============================================================================
# Сайт / Web Push (VAPID)
# =============================================================================
SITE_URL=https://dopx.kz
# ВАЖНО: VAPID_PRIVATE_KEY должен быть СОДЕРЖИМЫМ ключа (короткая строка
# ~43 символа в raw base64url), а НЕ путём к .vapid/private_key.pem —
# путь к файлу на конкретной машине не переживёт переезд на другой сервер
# или в Docker-контейнер (там просто нет такого пути на диске), и код
# молча перестанет отправлять push-уведомления.
#
# Если ключей ещё нет — просто оставь обе переменные пустыми и один раз
# выполни `python manage.py migrate` (или `python manage.py setup_push_keys`) —
# core/services/vapid.py сам сгенерирует пару и допишет значения сюда, в .env,
# уже в правильном (path-варианте для VAPID_PRIVATE_KEY, см. ниже как
# сконвертировать в строку).
#
# Если ключ уже есть как файл .vapid/private_key.pem (например, переносишь
# существующий .env с локальной машины на сервер) — сконвертируй его в
# строку одной командой и вставь результат вместо пути:
#   python -c "
#   import base64
#   from cryptography.hazmat.primitives import serialization
#   k = serialization.load_pem_private_key(open('.vapid/private_key.pem','rb').read(), password=None)
#   raw = k.private_numbers().private_value.to_bytes(32, 'big')
#   print(base64.urlsafe_b64encode(raw).rstrip(b'=').decode())
#   "
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@dopx.kz

# =============================================================================
# Безопасность
# =============================================================================
STAFF_2FA_ENFORCED=True
STAFF_SESSION_IDLE_TIMEOUT_SECONDS=1800
# True на первый прогон после смены CSP-политики (только логирует нарушения,
# не блокирует). На постоянку — False.
CSP_REPORT_ONLY=False
SECURE_SSL_REDIRECT=True
# Сколько обратных прокси стоит перед Gunicorn — в схеме nginx -> gunicorn
# из этого docker-compose.yml всегда 1, менять не нужно.
TRUSTED_PROXY_COUNT=1

# =============================================================================
# Мониторинг ошибок (Sentry) — необязательно, без ключа блок в settings.py
# просто no-op
# =============================================================================
SENTRY_DSN=

# =============================================================================
# Автосоздание суперпользователя при первом деплое (необязательно).
# Заполни один раз для первого запуска — дальше можно очистить, повторный
# запуск с уже существующим username безопасен (createsuperuser --noinput
# просто откажет и пойдёт дальше, entrypoint это игнорирует).
# =============================================================================
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
