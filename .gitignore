# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Django
db.sqlite3
*.sqlite3
media/
# staticfiles/ — это STATIC_ROOT (см. dopx/settings.py): выход
# `collectstatic`, генерируется на сервере, в git не нужен.
staticfiles/
# ИСПРАВЛЕНО: строка `static/` здесь игнорировала ИСХОДНУЮ директорию
# STATICFILES_DIRS (логотип, favicon, шрифты, JS, теперь ещё manifest.json/
# sw.js/push.js/PWA-иконки) — не выход сборки, а РУЧНЫЕ файлы репозитория.
# `git ls-files static/` до этой правки возвращал 0 файлов: весь каталог
# никогда не попадал в git. При клонировании на отдельный сервер сайт
# развернулся бы БЕЗ статики вообще (ни логотипа, ни JS, ни PWA-манифеста) —
# именно тот класс проблем "на деплое", которого стоит избегать сейчас,
# пока каталог static/ не разросся ещё больше.

# Environment
.env
.env.*
.envrc
.env.local
.env.production
# БАГ, найденный при аудите перед докеризацией: правило `.env.*` выше
# случайно матчило и .env.example — файл, который СПЕЦИАЛЬНО создан
# для того, чтобы лежать в git как публичный шаблон переменных окружения
# (без секретов). Без этой строчки `git add .` тихо пропускал бы его
# навсегда, и любой, кто клонирует репозиторий, не увидел бы вообще
# никакого шаблона .env.
!.env.example
# VAPID приватный ключ (core/management/commands/setup_push_keys.py) —
# секрет уровня .env, но живёт отдельным .pem-файлом, а не переменной.
.vapid/
venv/
app_venv/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Python build
build/
dist/
*.egg-info/

# Celery
celerybeat-schedule

# Testing
.pytest_cache/
.coverage
htmlcov/
# Отчёты scripts/verify_local.sh — локальный вывод одного прогона на
# конкретной машине разработчика, не артефакт для git (файл целиком
# копируется в чат вручную, когда нужно поделиться результатом).
scripts/verify_reports/

# Type checking
.mypy_cache/

# Logs — игнорируем только .log файлы, но сохраняем директорию через .gitkeep
logs/*.log
!logs/.gitkeep

# Node (future)
node_modules/dump.rdb
celerybeat-schedule.db
dump.rdb
celerybeat-schedule.db
